# ====================================================================
# Telegram Shaxsiy Userbot Konfiguratsiyasi
# ====================================================================

# 1. Telegram API Ma'lumotlari (https://my.telegram.org saytidan olinadi)
# my.telegram.org -> API development tools bo'limiga kiring
API_ID=12345678
API_HASH=your_api_hash_here

# 2. Sessiya va Ma'lumotlar Bazasi
# Sessiya fayli Telegram login ma'lumotlarini saqlaydi
SESSION_PATH=data/user_session
DATABASE_PATH=data/userbot.db

# 3. Profil Egasi Ismi (Xabar shablonlarida chiqariladi)
OWNER_NAME=Shohjahon

# 4. Auto-Reply (Bandlik xabari) Sozlamalari
AUTO_REPLY_ENABLED=true
# Bitta foydalanuvchiga qayta javob berish oralig'i (daqiqada)
AUTO_REPLY_COOLDOWN_MINUTES=30

# 5. VoIP Qo'ng'iroqlar Sozlamalari
CALL_HANDLER_ENABLED=true
MISSED_CALL_REPLY_ENABLED=true
POST_CALL_REPLY_ENABLED=true
# Bitta foydalanuvchiga ketma-ket qo'ng'iroqlarda takroriy xabar bormaslik oralig'i
CALL_COOLDOWN_MINUTES=15

# 6. Tug'ilgan Kun Tabriklash (Scheduler) Sozlamalari
BIRTHDAY_ENABLED=true
# Har kuni tekshirish vaqti (soat va daqiqa)
BIRTHDAY_CHECK_HOUR=0
BIRTHDAY_CHECK_MINUTE=1
# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# 7. Log darajasi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
